<% content_for :title do %>
  <%= Spree.t('otp_auth.admin.title', default: 'OTP Authentication Settings') %>
<% end %>

<% content_for :page_title do %>
  <%= Spree.t('otp_auth.admin.title', default: 'OTP Authentication Settings') %>
<% end %>

<div class="grid grid-cols-12 gap-6">
  <div class="col-span-12 lg:col-span-8 lg:col-start-3">
    <%= render 'spree/admin/shared/error_messages', target: @otp_configuration %>

    <div class="card mb-6">
      <div class="card-body flex items-center justify-between">
        <div>
          <h5 class="card-title text-base font-semibold text-gray-900 mb-1">
            Store Context: <%= current_store.name %>
          </h5>
          <p class="text-xs text-gray-500 mb-0">
            Settings configured here are strictly isolated to <strong><%= current_store.name %></strong> (Code: <%= current_store.code %>).
          </p>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
          <%= current_store.code.upcase %>
        </span>
      </div>
    </div>

    <%= form_with model: @otp_configuration, scope: :otp_configuration, url: spree.admin_otp_configuration_path, method: :patch, id: 'otp-configuration-form' do |f| %>
      <!-- Channel & Timing Section -->
      <div class="card mb-6">
        <div class="card-header border-b border-gray-200 px-6 py-4">
          <h5 class="card-title text-sm font-semibold text-gray-900">
            <%= Spree.t('otp_auth.admin.channel_header', default: 'Channel & Template Configuration') %>
          </h5>
        </div>
        <div class="card-body px-6 py-4 space-y-4">
          <div>
            <%
              channel_options = [
                ['WhatsApp (Gupshup)', 'whatsapp'],
                ['Email', 'email']
              ]
              # Keep a legacy SMS setting visible so saving doesn't silently change it.
              channel_options << ['Mobile SMS (MSG91)', 'mobile'] if @otp_configuration.active_channel == 'mobile'
            %>
            <%= f.spree_select :active_channel,
                  options_for_select(channel_options, @otp_configuration.active_channel),
                  { label: Spree.t('otp_auth.admin.active_channel', default: 'Primary Verification Channel') } %>
            <p class="text-xs text-gray-500 mt-1">
              Customers sign in with their mobile number. WhatsApp sends the code on WhatsApp; Email sends it to the account's email.
              Switching to WhatsApp needs the Gupshup settings below. Send a test message first.
            </p>
          </div>

          <div class="flex items-start gap-3">
            <%= f.check_box :fallback_channel,
                  { checked: @otp_configuration.email_fallback_enabled?, class: 'mt-1 h-4 w-4 rounded border-gray-300' },
                  'email', 'none' %>
            <div>
              <%= f.label :fallback_channel, Spree.t('otp_auth.admin.email_backup', default: 'Email backup'), class: 'text-sm font-medium text-gray-900' %>
              <p class="text-xs text-gray-500 mb-0">
                If WhatsApp can't deliver the code, send it to the customer's email automatically, and offer
                "Send code by email instead" on the code screen after the resend wait.
              </p>
            </div>
          </div>

          <div>
            <%= f.spree_select :email_template_id,
                  options_for_select(
                    [['Default Responsive OTP Mailer', '']] +
                    Spree::EmailTemplate.where(store_id: [current_store.id, nil]).map { |t| [t.name, t.id] },
                    @otp_configuration.email_template_id
                  ),
                  { label: Spree.t('otp_auth.admin.email_template', default: 'Transactional Email Template') } %>
            <p class="text-xs text-gray-500 mt-1">
              Select an email template configured in <a href="/admin/email_templates" class="text-blue-600 hover:underline font-medium" target="_blank">Email Templates</a> with <code>{{otp_code}}</code>, <code>{{store_name}}</code>, and <code>{{expiry_minutes}}</code> variables, or use the built-in responsive mailer.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
            <div>
              <%= f.spree_select :otp_length,
                    options_for_select([
                      ['6 Digits (Recommended)', 6],
                      ['4 Digits', 4]
                    ], @otp_configuration.otp_length),
                    { label: Spree.t('otp_auth.admin.otp_length', default: 'OTP Length') } %>
            </div>
            <div>
              <%= f.spree_number_field :otp_expiry_seconds,
                    label: Spree.t('otp_auth.admin.otp_expiry_seconds', default: 'OTP Expiry (seconds)'),
                    min: 60,
                    step: 10 %>
              <p class="text-xs text-gray-400 mt-1">Duration before OTP expires (min 60s, default 600s).</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.spree_number_field :resend_cooldown_seconds,
                    label: Spree.t('otp_auth.admin.resend_cooldown_seconds', default: 'Resend Cooldown (seconds)'),
                    min: 10,
                    step: 5 %>
              <p class="text-xs text-gray-400 mt-1">Wait duration before resend OTP is unlocked (default 30s).</p>
            </div>
            <div>
              <%= f.spree_number_field :fallback_delay_seconds,
                    label: Spree.t('otp_auth.admin.fallback_delay_seconds', default: 'Fallback Option Delay (seconds)'),
                    min: 10,
                    step: 5 %>
              <p class="text-xs text-gray-400 mt-1">Threshold before secondary fallback option button is displayed (default 20s).</p>
            </div>
          </div>
        </div>
      </div>

      <!-- WhatsApp via Gupshup -->
      <div class="card mb-6">
        <div class="card-header border-b border-gray-200 px-6 py-4 flex items-center justify-between">
          <h5 class="card-title text-sm font-semibold text-gray-900">
            <%= Spree.t('otp_auth.admin.gupshup_header', default: 'WhatsApp via Gupshup') %>
          </h5>
          <% if @otp_configuration.gupshup_api_key_present? %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
              <%= Spree.t('otp_auth.admin.gupshup_api_key_status', default: 'API key') %>: Configured
            </span>
          <% else %>
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
              <%= Spree.t('otp_auth.admin.gupshup_api_key_status', default: 'API key') %>: Missing
            </span>
          <% end %>
        </div>
        <div class="card-body px-6 py-4 space-y-4">
          <p class="text-xs text-gray-500 mb-0">
            The API key is read from <code>GUPSHUP_API_KEY</code> in the server environment and is never stored or shown here.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.spree_text_field :gupshup_source_number,
                    label: Spree.t('otp_auth.admin.gupshup_source_number', default: 'Business WhatsApp number'),
                    placeholder: '919876543210' %>
              <p class="text-xs text-gray-400 mt-1">The registered WhatsApp Business number, with country code.</p>
            </div>
            <div>
              <%= f.spree_text_field :gupshup_app_name,
                    label: Spree.t('otp_auth.admin.gupshup_app_name', default: 'Gupshup app name'),
                    placeholder: 'MyStoreApp' %>
              <p class="text-xs text-gray-400 mt-1">Sent to Gupshup as <code>src.name</code>.</p>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div>
              <%= f.spree_text_field :gupshup_app_id,
                    label: Spree.t('otp_auth.admin.gupshup_app_id', default: 'Gupshup app ID') %>
              <p class="text-xs text-gray-400 mt-1">Used to look up the template by name.</p>
            </div>
            <div>
              <%= f.spree_text_field :gupshup_template_name,
                    label: Spree.t('otp_auth.admin.gupshup_template_name', default: 'Template name'),
                    value: @otp_configuration.effective_gupshup_template_name %>
              <p class="text-xs text-gray-400 mt-1">Approved WhatsApp template, e.g. <code>verify_otp</code>.</p>
            </div>
            <div>
              <%= f.spree_text_field :gupshup_template_id,
                    label: Spree.t('otp_auth.admin.gupshup_template_id', default: 'Template ID (optional)'),
                    placeholder: 'Leave blank to look up by name' %>
            </div>
          </div>

          <div>
            <p class="text-sm font-medium text-gray-900 mb-1">
              <%= Spree.t('otp_auth.admin.gupshup_webhook_url', default: 'Delivery callback URL') %>
            </p>
            <% webhook_secret = ENV['GUPSHUP_WEBHOOK_SECRET'].to_s %>
            <% if webhook_secret.present? %>
              <code class="text-xs break-all"><%= request.base_url %>/webhooks/gupshup?secret=••••••••<%= webhook_secret.last(4) %></code>
              <p class="text-xs text-gray-400 mt-1">
                Paste this in your Gupshup app's callback settings, with the full secret from <code>GUPSHUP_WEBHOOK_SECRET</code>.
                It lets the store switch a code to email when WhatsApp can't deliver it.
              </p>
            <% else %>
              <p class="text-xs text-red-700 mb-0">
                Set <code>GUPSHUP_WEBHOOK_SECRET</code> in the server environment to enable delivery callbacks.
              </p>
            <% end %>
          </div>
        </div>
      </div>

      <!-- Provider Credentials Section -->
      <div class="card mb-6">
        <div class="card-header border-b border-gray-200 px-6 py-4">
          <h5 class="card-title text-sm font-semibold text-gray-900">
            <%= Spree.t('otp_auth.admin.msg91_header', default: 'MSG91 Provider Credentials & DLT Templates') %>
            <span class="text-xs font-normal text-gray-500">(SMS only)</span>
          </h5>
        </div>
        <div class="card-body px-6 py-4 space-y-4">
          <div>
            <%= f.spree_text_field :msg91_auth_key,
                  label: Spree.t('otp_auth.admin.msg91_auth_key', default: 'MSG91 Auth Key'),
                  value: nil,
                  placeholder: (@otp_configuration.msg91_auth_key.present? ? '••••••••' : 'Enter MSG91 Auth Key') %>
            <p class="text-xs text-gray-500 mt-1">
              Encrypted at rest with ActiveRecord encryption. Leave blank to retain existing key.
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <%= f.spree_text_field :msg91_sender_id,
                    label: Spree.t('otp_auth.admin.msg91_sender_id', default: 'Sender ID (Header)'),
                    placeholder: 'ONTODI' %>
              <p class="text-xs text-gray-400 mt-1">6-character DLT registered header.</p>
            </div>
            <div>
              <%= f.spree_text_field :msg91_sms_template_id,
                    label: Spree.t('otp_auth.admin.msg91_sms_template_id', default: 'SMS Template ID'),
                    placeholder: 'e.g. 64b8...' %>
              <p class="text-xs text-gray-400 mt-1">Pre-approved DLT Template ID.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="form-actions mt-6 flex justify-end">
        <%= f.submit Spree.t(:update, default: 'Update Settings'), class: 'btn btn-primary' %>
      </div>
    <% end %>

    <!-- Test send (separate form: uses the saved settings) -->
    <div class="card mt-6">
      <div class="card-header border-b border-gray-200 px-6 py-4">
        <h5 class="card-title text-sm font-semibold text-gray-900">
          <%= Spree.t('otp_auth.admin.test_whatsapp', default: 'Send test WhatsApp') %>
        </h5>
      </div>
      <div class="card-body px-6 py-4">
        <%= form_with url: spree.test_whatsapp_admin_otp_configuration_path, method: :post, class: 'flex flex-col sm:flex-row gap-3 sm:items-end' do %>
          <div class="flex-1">
            <%= label_tag :test_phone, 'Phone number', class: 'text-sm font-medium text-gray-900' %>
            <%= telephone_field_tag :test_phone, nil, placeholder: '9876543210', class: 'form-control' %>
          </div>
          <%= submit_tag Spree.t('otp_auth.admin.test_whatsapp', default: 'Send test WhatsApp'), class: 'btn btn-light' %>
        <% end %>
        <p class="text-xs text-gray-500 mt-2 mb-0">
          Sends the <code><%= @otp_configuration.effective_gupshup_template_name %></code> template with code 123456 using the
          <strong>saved</strong> settings. Save first if you changed anything above.
        </p>
      </div>
    </div>
  </div>
</div>
